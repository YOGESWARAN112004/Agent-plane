# Production Environment Variables for AgentPlane
# Rename this file to .env before deploying

# ==========================================
# 🔐 SECRETS (CRITICAL)
# Generate these using `openssl rand -hex 16`
# ==========================================
SESSION_SECRET=
MAGIC_LINK_SECRET=
ENCRYPTION_KEY=
MANAGED_WORKER_SECRET=

# ==========================================
# 🌐 DOMAIN CONFIGURATION
# Replace 'example.com' with your actual domain
# ==========================================
APP_ORIGIN=https://app.example.com
LOGIN_ORIGIN=https://app.example.com
API_ORIGIN=https://app.example.com
DEV_OTEL_EXPORTER_OTLP_ENDPOINT=https://app.example.com/otel

# ==========================================
# 📧 EMAIL CONFIGURATION (REQUIRED)
# Choose one transport method (Resend, SMTP, or AWS SES)
# ==========================================
FROM_EMAIL=noreply@example.com
REPLY_TO_EMAIL=support@example.com

# Option 1: Resend
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_123456789

# Option 2: SMTP
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user
# SMTP_PASSWORD=pass

# Option 3: AWS SES
# EMAIL_TRANSPORT=aws-ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ==========================================
# 🐳 DOCKER REGISTRY
# You must push your images to a registry (Docker Hub, ECR, etc.)
# ==========================================
DOCKER_REGISTRY_URL=registry.example.com
DOCKER_REGISTRY_USERNAME=user
DOCKER_REGISTRY_PASSWORD=password
DOCKER_REGISTRY_NAMESPACE=agentplane

# ==========================================
# ☁️ MINIO / S3 OBJECT STORAGE
# ==========================================
# Internal MinIO (default)
OBJECT_STORE_ACCESS_KEY_ID=admin
OBJECT_STORE_SECRET_ACCESS_KEY=change-this-password-immediately
# For production, we recommend external S3
# OBJECT_STORE_BASE_URL=https://s3.amazonaws.com
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change-this-password-immediately

# ==========================================
# 🐘 DATABASE & REDIS
# We recommend using managed services (RDS, ElastiCache) for production
# ==========================================
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://postgres:change-this-password@postgres:5432/main?schema=public&sslmode=disable
DIRECT_URL=postgresql://postgres:change-this-password@postgres:5432/main?schema=public&sslmode=disable

CLICKHOUSE_PASSWORD=change-this-password
CLICKHOUSE_URL=http://default:change-this-password@clickhouse:8123?secure=false
RUN_REPLICATION_CLICKHOUSE_URL=http://default:change-this-password@clickhouse:8123

# ==========================================
# 🔒 TRAEFIK (SSL)
# ==========================================
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_Hub_ID=
# If using Let's Encrypt, configure it in docker-compose.traefik.yml

# ==========================================
# ⚙️ PERFORMANCE TUNING
# ==========================================
# 4GB Machine: 3200, 8GB: 6400
NODE_MAX_OLD_SPACE_SIZE=3200
TRIGGER_IMAGE_TAG=v4-beta
